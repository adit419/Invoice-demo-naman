              "host": [
                "{{base_url}}"
              ],
              "path": [
                "dp-api",
                "ingestion",
                "trigger-upload"
              ]
            },
            "description": "An FP name ATTACHES to the invoice's existing run instead of creating one, so two names collapse to a single run. FP aliases: GRAHA INV_FP_3\u2192invoice_1, INV_FP_2\u2192invoice_2, INV_FP_5\u2192invoice_3, INV_FP_4\u2192invoice_4; PALLADIUM has INV_FP_4/5/6.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"file_names\": [\n    \"GRAHA_MEGARIA_INV_2.pdf\",\n    \"GRAHA_MEGARIA_INV_FP_2.pdf\"\n  ],\n  \"email\": \"{{notify_email}}\"\n}",
              "options": {
