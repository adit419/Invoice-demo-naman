{
  "info": {
    "_postman_id": "dp-trigger-upload-0001",
    "name": "DirectPay \u2014 trigger-upload",
    "description": "Fixture-driven DirectPay ingestion.\n\nBOTH trigger-upload endpoints take the SAME payload: `file_names` (required \u2014 a string or an array) plus optional `email` and `tag`.\n\nRun **Setup \u2192 Get Token** first; it saves the token into the `token` collection variable, and collection-level Bearer auth picks it up for every other request.\n\nGOTCHA: an unrecognised file name does NOT 404 \u2014 fixture resolution falls back to an arbitrary bundle, so a typo silently creates a run against the wrong vendor. Use the names in these requests verbatim.\n\n`email` is the ONLY notification recipient and there is no fallback: include it and that address receives the confirmation / action-required / escalation mails; omit it and processing is identical but silent.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8099",
      "description": "Backend directly. http://localhost:3000 also works if the frontend is up (it proxies /dp-api/*)."
    },
    {
      "key": "token",
      "value": "",
      "description": "Filled in by Setup \u2192 Get Token."
    },
    {
      "key": "notify_email",
      "value": "adit.n@neoflo.ai",
      "description": "Goes into the `email` field. This address receives the notifications."
    },
    {
      "key": "invoice_id",
      "value": "",
      "description": "Filled in by an invoice upload, used by Escalate."
    }
  ],
  "item": [
    {
      "name": "0 \u00b7 Setup",
      "item": [
        {
          "name": "Get Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "username",
                  "value": "admin@neoflo.ai",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "Admin@123",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/token",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "token"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Returns a bare {access_token, token_type} \u2014 not enveloped. The test script saves it."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const t = pm.response.json().access_token;",
                  "pm.collectionVariables.set(\"token\", t);",
                  "pm.test(\"token saved\", () => pm.expect(t).to.be.a(\"string\").and.not.empty);",
                  "console.log(\"token saved to the {{token}} collection variable\");"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1 \u00b7 Contracts",
      "item": [
        {
          "name": "Multiple contracts (all 7)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/dp-api/contracts/trigger-upload",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "dp-api",
                "contracts",
                "trigger-upload"
              ]
            },
            "description": "One run per file \u2014 contracts are never deduped, so 7 names means 7 runs.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"file_names\": [\n    \"PT_BANGUN_CONTRACT.pdf\",\n    \"PALLADIUM_CONTRACT.pdf\",\n    \"PAKUWON_CONTRACT.pdf\",\n    \"KARYA_NASTARI_CONTRACT.pdf\",\n    \"RATNA_INTAN_CONTRACT.pdf\",\n    \"GRAHA_MEGARIA_CONTRACT.pdf\",\n    \"DEBORA_KEMANG_CONTRACT.pdf\"\n  ],\n  \"email\": \"{{notify_email}}\",\n  \"tag\": \"vendor-onboarding-q3\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const d = pm.response.json().data;",
                  "const runs = d.items || [d];",
                  "pm.test(\"7 run(s) created\", () => pm.expect(runs.length).to.eql(7));",
                  "runs.forEach(r => console.log(r.fixture_key, r.id, r.status));"
                ]
              }
            }
          ]
        },
        {
          "name": "Single contract (bare string)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/dp-api/contracts/trigger-upload",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "dp-api",
                "contracts",
                "trigger-upload"
              ]
            },
            "description": "`file_names` accepts a bare string; one name returns the bare run object rather than {items}.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"file_names\": \"PT_BANGUN_CONTRACT.pdf\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const d = pm.response.json().data;",
                  "const runs = d.items || [d];",
                  "pm.test(\"1 run(s) created\", () => pm.expect(runs.length).to.eql(1));",
                  "runs.forEach(r => console.log(r.fixture_key, r.id, r.status));"
                ]
              }
            }
          ]
        },
        {
          "name": "Contracts, no email (silent)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/dp-api/contracts/trigger-upload",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "dp-api",
                "contracts",
                "trigger-upload"
              ]
            },
            "description": "No `email` \u2014 identical processing, no notification sent to anyone.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"file_names\": [\n    \"PALLADIUM_CONTRACT.pdf\",\n    \"PAKUWON_CONTRACT.pdf\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const d = pm.response.json().data;",
                  "const runs = d.items || [d];",
                  "pm.test(\"2 run(s) created\", () => pm.expect(runs.length).to.eql(2));",
                  "runs.forEach(r => console.log(r.fixture_key, r.id, r.status));"
                ]
              }
            }
          ]
        }
      ]
    },
